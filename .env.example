# ──────────────────────────────────────────────
# TeleTrader - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ──────────────────────────────────────────────

DASHBOARD_PORT=8080

# ── Telegram ──────────────────────────────────
# Get API_ID and API_HASH from https://my.telegram.org
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+1234567890

# Group/channel ID (negative number for groups, e.g. -1001234567890)
# Tip: Forward a message from the group to @userinfobot to get the ID
TELEGRAM_GROUP_ID=-1001234567890

# ── MetaTrader 5 ──────────────────────────────
MT5_LOGIN=123456
MT5_PASSWORD=your_mt5_password
MT5_SERVER=YourBroker-Live
MT5_SYMBOL_SUFFIX=.bp

# Optional: Add extra MT5 accounts (for multi-account management)
# if there are more than one account, separate them with commas and use the format:
# MT5_EXTRA_ACCOUNTS=login:password:server|path_to_terminal.exe,login:password:server:path_to_terminal.exe
# MT5_EXTRA_ACCOUNTS=789012:password2:BrokerServer-Live|C:\MT5_Account2\terminal64.exe

# ── Risk Management ───────────────────────────
DEFAULT_LOT_SIZE=0.01
MAX_LOT_SIZE=0.10
MAX_OPEN_TRADES=5
MAX_DAILY_LOSS_USD=100.0

# ── Symbol Whitelist (optional) ───────────────
# Leave empty to allow all symbols
# Comma-separated, no spaces: XAUUSD,EURUSD,GBPUSD
ALLOWED_SYMBOLS=
